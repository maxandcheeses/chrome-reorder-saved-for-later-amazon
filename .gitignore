.DS_Store
*.zip
node_modules/

# Claude Code local/session data — settings, permissions, transcripts, and
# any prompt/history logs must never be committed. Shareable project config
# like .claude/agents/ and .claude/commands/ is intentionally NOT excluded
# here so it can be committed and reused by the team.
.claude/settings.local.json
.claude/*.log
.claude/sessions/
.claude/history/

# Secrets / credentials, in case any ever land here
.env
.env.*
*.pem
*.key
*.p12
*credentials*
*secret*
*.log
